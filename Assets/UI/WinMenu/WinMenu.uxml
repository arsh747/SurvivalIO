<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">

  <!-- STYLESHEETS — embedded, no Inspector setup needed -->
  <Style src="project://database/Assets/UI/MainMenu/MainMenu.uss" />
  <Style src="project://database/Assets/UI/WinMenu/WinMenu.uss" />

  <ui:VisualElement name="root" class="root">

    <!-- SCANLINE OVERLAY -->
    <ui:VisualElement name="scanlines" class="scanlines" picking-mode="Ignore" />

    <!-- TOP STATUS BAR -->
    <ui:VisualElement name="status-bar" class="status-bar">
      <ui:Label name="status-left" class="status-text" text="SURVIVAL-IO // VICTORY SCREEN" />
      <ui:VisualElement class="status-center">
        <ui:VisualElement name="pulse-dot" class="pulse-dot pulse-dot--win" />
        <ui:Label class="status-text" text="MISSION COMPLETE" />
      </ui:VisualElement>
      <ui:Label name="status-right" class="status-text" text="AUDIO ON  |  v0.1.0 ALPHA" />
    </ui:VisualElement>

    <!-- MAIN CONTENT AREA -->
    <ui:VisualElement name="content" class="content">

      <!-- LEFT PANEL: MISSION DEBRIEF -->
      <ui:VisualElement name="left-panel" class="side-panel left-panel">
        <ui:Label class="panel-title" text="MISSION DEBRIEF" />
        <ui:VisualElement class="intel-divider" />
        <ui:VisualElement class="intel-list">
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-green" text="✓" />
            <ui:Label class="intel-text" text="Zone secured and hostiles eliminated." />
          </ui:VisualElement>
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-green" text="✓" />
            <ui:Label class="intel-text" text="Perimeter held through all waves." />
          </ui:VisualElement>
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-green" text="✓" />
            <ui:Label class="intel-text" text="Base integrity maintained." />
          </ui:VisualElement>
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-yellow" text="!" />
            <ui:Label class="intel-text" text="Next zone requires higher firepower." />
          </ui:VisualElement>
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-yellow" text="!" />
            <ui:Label class="intel-text" text="Elite units reported ahead. Stay sharp." />
          </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="spacer" />

        <ui:Label class="panel-title" text="NEXT ZONE INTEL" />
        <ui:VisualElement class="intel-divider" />
        <ui:VisualElement class="run-stats">
          <ui:VisualElement class="run-row">
            <ui:Label class="run-label" text="THREAT" />
            <ui:Label class="run-value accent-red" text="ELEVATED" />
          </ui:VisualElement>
          <ui:VisualElement class="run-row">
            <ui:Label class="run-label" text="ENEMY TYPE" />
            <ui:Label class="run-value" text="ELITES" />
          </ui:VisualElement>
          <ui:VisualElement class="run-row">
            <ui:Label class="run-label" text="STATUS" />
            <ui:Label class="run-value accent-green" text="DEPLOY READY" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- CENTER PANEL: WIN TITLE + BUTTONS -->
      <ui:VisualElement name="center-panel" class="center-panel">

        <ui:VisualElement name="title-block" class="title-block">
          <ui:Label class="eyebrow-label eyebrow--win" text="✦ ZONE CLEARED ✦" />
          <ui:Label name="win-title" class="game-title win-title" text="YOU WIN!" />
          <ui:Label class="subtitle-label" text="MISSION COMPLETE  •  ADVANCE  •  DOMINATE" />
        </ui:VisualElement>

        <ui:VisualElement name="menu-buttons" class="menu-buttons">
          <ui:Button name="btn-nextlvl" class="menu-btn btn-win">
            <ui:Label class="btn-label" text="NEXT LEVEL" />
            <ui:Label class="btn-arrow" text="▶" />
          </ui:Button>
          <ui:Button name="btn-menu" class="menu-btn">
            <ui:Label class="btn-label" text="MAIN MENU" />
            <ui:Label class="btn-arrow" text="▶" />
          </ui:Button>
        </ui:VisualElement>

      </ui:VisualElement>

      <!-- RIGHT PANEL: COMMENDATIONS + INTEL -->
      <ui:VisualElement name="right-panel" class="side-panel right-panel">
        <ui:Label class="panel-title" text="COMMENDATIONS" />
        <ui:VisualElement class="intel-divider" />
        <ui:VisualElement class="intel-list">
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-gold" text="★" />
            <ui:Label class="intel-text" text="Zone Dominator — cleared all enemies." />
          </ui:VisualElement>
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-gold" text="★" />
            <ui:Label class="intel-text" text="Survivor — base health above 50%." />
          </ui:VisualElement>
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-green" text="▸" />
            <ui:Label class="intel-text" text="Efficiency — minimal ammo wasted." />
          </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="spacer" />

        <ui:Label class="panel-title" text="INTEL FEED" />
        <ui:VisualElement class="intel-divider" />
        <ui:VisualElement class="intel-list">
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-green" text="▸" />
            <ui:Label class="intel-text" text="Next zone unlocked — proceed." />
          </ui:VisualElement>
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-yellow" text="▸" />
            <ui:Label class="intel-text" text="Resupply crates dropped at spawn." />
          </ui:VisualElement>
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-red" text="▸" />
            <ui:Label class="intel-text" text="High-value target sighted in Bldg 7." />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

    </ui:VisualElement>

    <!-- BOTTOM STATUS BAR -->
    <ui:VisualElement name="footer-bar" class="status-bar footer-bar">
      <ui:Label class="status-text" text="▸ MISSION COMPLETE" />
      <ui:Label class="status-text" text="LANDSCAPE MODE" />
    </ui:VisualElement>

  </ui:VisualElement>
</ui:UXML>
