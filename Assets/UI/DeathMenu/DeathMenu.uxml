<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">

  <!-- STYLESHEETS — both embedded here, no Inspector setup needed -->
  <Style src="project://database/Assets/UI/MainMenu/MainMenu.uss" />
  <Style src="project://database/Assets/UI/DeathMenu/DeathMenu.uss" />

  <ui:VisualElement name="root" class="root">

    <!-- SCANLINE OVERLAY -->
    <ui:VisualElement name="scanlines" class="scanlines" picking-mode="Ignore" />

    <!-- TOP STATUS BAR -->
    <ui:VisualElement name="status-bar" class="status-bar">
      <ui:Label name="status-left" class="status-text" text="SURVIVAL-IO // DEATH SCREEN" />
      <ui:VisualElement class="status-center">
        <ui:VisualElement name="pulse-dot" class="pulse-dot pulse-dot--dead" />
        <ui:Label class="status-text" text="SYSTEM ONLINE" />
      </ui:VisualElement>
      <ui:Label name="status-right" class="status-text" text="AUDIO ON  |  v0.1.0 ALPHA" />
    </ui:VisualElement>

    <!-- MAIN CONTENT AREA -->
    <ui:VisualElement name="content" class="content">

      <!-- LEFT PANEL: SURVIVAL TIPS -->
      <ui:VisualElement name="left-panel" class="side-panel left-panel">
        <ui:Label class="panel-title" text="SURVIVAL TIPS" />
        <ui:VisualElement class="intel-divider" />
        <ui:VisualElement class="intel-list">
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-green" text="▸" />
            <ui:Label class="intel-text" text="Stay mobile — standing still draws enemy fire." />
          </ui:VisualElement>
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-green" text="▸" />
            <ui:Label class="intel-text" text="Upgrade weapons before entering a new zone." />
          </ui:VisualElement>
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-green" text="▸" />
            <ui:Label class="intel-text" text="Use buildings for cover during heavy waves." />
          </ui:VisualElement>
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-green" text="▸" />
            <ui:Label class="intel-text" text="Pick up health packs before your bar hits red." />
          </ui:VisualElement>
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-green" text="▸" />
            <ui:Label class="intel-text" text="Eliminate ranged enemies first." />
          </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="spacer" />

        <ui:Label class="panel-title" text="NEXT TIME" />
        <ui:VisualElement class="intel-divider" />
        <ui:VisualElement class="run-stats">
          <ui:VisualElement class="run-row">
            <ui:Label class="run-label" text="FOCUS" />
            <ui:Label class="run-value accent-green" text="MOBILITY" />
          </ui:VisualElement>
          <ui:VisualElement class="run-row">
            <ui:Label class="run-label" text="PRIORITY" />
            <ui:Label class="run-value" text="RANGED UNITS" />
          </ui:VisualElement>
          <ui:VisualElement class="run-row">
            <ui:Label class="run-label" text="STRATEGY" />
            <ui:Label class="run-value" text="HIT AND RUN" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

      <!-- CENTER PANEL: DEATH TITLE + BUTTONS -->
      <ui:VisualElement name="center-panel" class="center-panel">

        <ui:VisualElement name="title-block" class="title-block">
          <ui:Label class="eyebrow-label eyebrow--dead" text="!! OPERATOR DOWN !!" />
          <ui:Label name="death-title" class="game-title" text="YOU LOST" />
          <ui:Label class="subtitle-label" text="ZONE CONTROL FAILED  •  REGROUP  •  TRY AGAIN" />
        </ui:VisualElement>

        <ui:VisualElement name="menu-buttons" class="menu-buttons">
          <ui:Button name="btn-retry" class="menu-btn btn-play">
            <ui:Label class="btn-label" text="TRY AGAIN" />
            <ui:Label class="btn-arrow" text="▶" />
          </ui:Button>
          <ui:Button name="btn-menu" class="menu-btn">
            <ui:Label class="btn-label" text="MAIN MENU" />
            <ui:Label class="btn-arrow" text="▶" />
          </ui:Button>
        </ui:VisualElement>

      </ui:VisualElement>

      <!-- RIGHT PANEL: COMMON MISTAKES + INTEL -->
      <ui:VisualElement name="right-panel" class="side-panel right-panel">
        <ui:Label class="panel-title" text="COMMON MISTAKES" />
        <ui:VisualElement class="intel-divider" />
        <ui:VisualElement class="intel-list">
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-red" text="✕" />
            <ui:Label class="intel-text" text="Ignoring the minimap warnings." />
          </ui:VisualElement>
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-red" text="✕" />
            <ui:Label class="intel-text" text="Fighting multiple elites at once." />
          </ui:VisualElement>
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-red" text="✕" />
            <ui:Label class="intel-text" text="Wasting ammo on weak units." />
          </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="spacer" />

        <ui:Label class="panel-title" text="INTEL FEED" />
        <ui:VisualElement class="intel-divider" />
        <ui:VisualElement class="intel-list">
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-red" text="▸" />
            <ui:Label class="intel-text" text="Enemy active Zone 3" />
          </ui:VisualElement>
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-yellow" text="▸" />
            <ui:Label class="intel-text" text="Perimeter breach near Bldg 5" />
          </ui:VisualElement>
          <ui:VisualElement class="intel-item">
            <ui:Label class="intel-bullet accent-red" text="▸" />
            <ui:Label class="intel-text" text="Low health — resupply!" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>

    </ui:VisualElement>

    <!-- BOTTOM STATUS BAR -->
    <ui:VisualElement name="footer-bar" class="status-bar footer-bar">
      <ui:Label class="status-text" text="▸ SYSTEM ONLINE" />
      <ui:Label class="status-text" text="LANDSCAPE MODE" />
    </ui:VisualElement>

  </ui:VisualElement>
</ui:UXML>
